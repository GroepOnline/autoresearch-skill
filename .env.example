# Copy to .env.local (or platform-specific secret storage) and fill values locally.
# Do not commit real secrets. Placeholders intentionally stay empty.

# Runtime mode and safety defaults
APP_ENV=development
DRY_RUN=true
REQUIRE_HUMAN_APPROVAL_FOR_DESTRUCTIVE_ACTIONS=true
MAX_AGENT_STEPS=25
MAX_TOOL_CALLS_PER_RUN=80
AI_RATE_LIMIT_RPM=30
AI_REQUEST_TIMEOUT_MS=60000

# AI provider selection
AI_PROVIDER=stub
AI_MODEL=local-placeholder
AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Computer-use / browser automation safety
COMPUTER_USE_ENABLED=false
COMPUTER_USE_ALLOWED_DOMAINS=localhost,127.0.0.1,github.com
COMPUTER_USE_BLOCK_DESTRUCTIVE_ACTIONS=true
COMPUTER_USE_SCREENSHOT_DIR=.artifacts/screenshots
COMPUTER_USE_ARTIFACT_DIR=.artifacts/computer-use
COMPUTER_USE_REDACT_SCREENSHOTS=true
COMPUTER_USE_MAX_STEPS=20

# Logging and artifacts
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true
ARTIFACT_DIR=.artifacts
STATE_DIR=.state
