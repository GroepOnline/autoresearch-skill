{
  "name": "pi-autoresearch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "autoresearch",
    "benchmark"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepChef/autoresearch-skill.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extension.ts",
    "extensions/",
    "agents/",
    "references/",
    "scripts/*.py",
    "scripts/*.mjs",
    "scripts/*.sh",
    "types/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "SKILL.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/autoresearch/index.ts"
    ],
    "skills": [
      "."
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-python-tests.mjs",
    "test:ts": "node scripts/run-ts-tests.mjs",
    "validate": "node scripts/validate.mjs",
    "lint": "eslint extensions/**/*.ts --max-warnings 0",
    "lint:fix": "eslint extensions/**/*.ts --fix",
    "format": "prettier --write \"extensions/**/*.ts\" \"tests-ts/**/*.ts\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"tests-ts/**/*.ts\"",
    "package:clean": "bash scripts/package-clean.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
