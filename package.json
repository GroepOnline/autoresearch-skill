{
  "name": "@groeponline/pi-autoresearch",
  "version": "1.4.0",
  "description": "Pi extension and Agent Skill for bounded, benchmark-driven autoresearch loops in code repositories.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "OnlineChef",
  "homepage": "https://github.com/GroepOnline/autoresearch-skill#readme",
  "bugs": {
    "url": "https://github.com/GroepOnline/autoresearch-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/autoresearch-skill.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "agent-skill",
    "autoresearch",
    "benchmark",
    "optimization",
    "coding-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extension.ts",
    "extensions/",
    "skills/",
    "agents/",
    "references/",
    "docs/",
    "scripts/*.py",
    "scripts/*.mjs",
    "scripts/*.sh",
    "types/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/autoresearch/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-python-tests.mjs",
    "test:ts": "node scripts/run-ts-tests.mjs",
    "test:e2e": "bash scripts/e2e-automated-test.sh",
    "test:e2e:pi": "bash scripts/autoresearch-e2e-test.sh",
    "validate": "node scripts/validate.mjs",
    "benchmark": "node scripts/benchmark-code-quality.mjs",
    "benchmark:comparison": "node scripts/benchmark-comparison.mjs",
    "lint": "eslint extensions/**/*.ts --max-warnings 0",
    "lint:fix": "eslint extensions/**/*.ts --fix",
    "format": "prettier --write \"extensions/**/*.ts\" \"tests-ts/**/*.ts\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"tests-ts/**/*.ts\"",
    "package": "node scripts/package-clean.mjs",
    "package:clean": "node scripts/package-clean.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.24.4"
  }
}
