{
  "name": "@groeponline/pi-autoresearch",
  "version": "2.0.0",
  "description": "Pi extension and Agent Skill for bounded, benchmark-driven autoresearch loops in code repositories.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "OnlineChef",
  "homepage": "https://github.com/GroepOnline/autoresearch-skill#readme",
  "bugs": {
    "url": "https://github.com/GroepOnline/autoresearch-skill/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroepOnline/autoresearch-skill.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "agent-skill",
    "autoresearch",
    "benchmark",
    "optimization",
    "coding-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "extension.ts",
    "extensions/",
    "skills/",
    "references/",
    "scripts/",
    "types/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "SKILL.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/autoresearch/index.ts"
    ],
    "skills": [
      "./skills/pi-autoresearch"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:ts": "tsx --test tests-ts/*.test.ts",
    "validate": "npm test && npm run test:ts && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.74.0"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  }
}
