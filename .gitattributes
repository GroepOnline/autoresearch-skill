# Auto detect text files and normalize to LF
* text=auto eol=lf

# Explicitly declare text files that should use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf

# Declare files that will always have CRLF on checkout (Windows-specific)
# None needed for this project - we use LF everywhere

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
